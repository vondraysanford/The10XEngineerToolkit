# Never let these reach an image. An image is an archive that people pull.
.git/
.env
.env.*
*.pem
*.pfx
secrets/

# Local artifacts that bloat the build context
node_modules/
bin/
obj/
dist/
build/
.venv/
__pycache__/
coverage/
TestResults/

# Docs and local tooling
*.md
.vscode/
.idea/
.claude/
.github/
