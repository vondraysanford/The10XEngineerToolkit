{
  "permissions": {
    "ask": [
      "Bash(dotnet add:*)",
      "Bash(dotnet tool install:*)",
      "Bash(nuget install:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm add:*)",
      "Bash(pnpm add:*)",
      "Bash(yarn add:*)",
      "Bash(npx:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(uv add:*)",
      "Bash(uv pip install:*)",
      "Bash(poetry add:*)",
      "Bash(brew install:*)",
      "Bash(brew tap:*)",
      "Bash(gem install:*)",
      "Bash(cargo add:*)",
      "Bash(cargo install:*)",
      "Bash(go get:*)",
      "Bash(go install:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // empty' | grep -Eq '\\|[[:space:]]*(sudo[[:space:]]+)?(ba|z|da)?sh([[:space:]]|$)' && { echo 'Blocked by agent-install-guard: pipe-to-shell. Download the script, read it, then run it.' >&2; exit 2; } || exit 0"
          }
        ]
      }
    ]
  }
}
